{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Git Tools",
  "version": "0.13.2",
  "identifier": "io.gittools.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Git Tools",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQTJBRDIwQzZBMDk1NzkKUldSNWxhREdJSzJpTDNRNlJVM3hzK3lBL25IRmZVRWxhbGpHZ0tldTNnV1hJRUMxa2J5blJPNlgK",
      "endpoints": ["https://github.com/hyzmm/git-merger/releases/latest/download/latest.json"]
    }
  }
}
